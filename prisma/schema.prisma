generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movie {
  id          String   @id @default(uuid())
  title       String
  description String
  isWatched   Boolean  @default(false)
  rating      Int?
  createdAt   DateTime @default(now())
}
